<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>MioAmp</title>
    <welcome file="Welcome.html" mime-type="text/html"/>
    <options customize="never" require-scripts="false" hostArchitectures="arm64,x86_64"/>
    <domains enable_anywhere="false" enable_currentUserHome="true" enable_localSystem="true"/>
    <volume-check>
        <allowed-os-versions>
            <os-version min="14.0"/>
        </allowed-os-versions>
    </volume-check>
    <choices-outline>
        <line choice="mioamp"/>
    </choices-outline>
    <choice id="mioamp" title="MioAmp" description="Customizable local audio player for Mac" visible="false">
        <pkg-ref id="io.github.h0ck3ystyx.mioamp.installer"/>
    </choice>
    <pkg-ref id="io.github.h0ck3ystyx.mioamp.installer">MioAmp-component.pkg</pkg-ref>
</installer-gui-script>
